# Optional AI explanations. Without a key, template explanations are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional authorized external registry API adapter.
# POST JSON: {"tax_id":"...", "country":"..."}
# Expected response JSON: {"status":"ACTIVE|INACTIVE|NOT_FOUND|...", "company_name":"...", "message":"..."}
VENDOR_REGISTRY_URL=
VENDOR_REGISTRY_API_KEY=

# SQLite database path (relative to the project root by default)
DATABASE_PATH=vendorguard.db
